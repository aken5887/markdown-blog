# Leave both empty for local-only mode.
# In that mode nothing changes from the original app: posts/ and public/images/
# are read and written directly on this machine, no GitHub account needed.

# GitHub repo used to persist posts/ and images/ across Render redeploys
# (Render's disk resets on every deploy/restart, so this repo is the real storage).
# Create an EMPTY repo on GitHub first and check "Add a README file" so it has
# an initial commit, e.g.: https://github.com/yourname/local-blog-data
DATA_REPO_URL=

# GitHub Personal Access Token (fine-grained), scoped to ONLY the data repo above,
# with "Contents: Read and write" permission. Generate at:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Write UI / mutating APIs:
# - Local (NODE_ENV unset): writable by default
# - Production (Render sets NODE_ENV=production): read-only by default
# Override either way with ALLOW_WRITES=true|false
# ALLOW_WRITES=false
